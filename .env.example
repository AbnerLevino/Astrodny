# Configuração do Astrodny — copie este arquivo para `.env.local` e ajuste os valores.
# (o `.env.local` é lido pelo Vite e NÃO deve ir pro versionamento)

# Onde a IA responde (Ollama ou o proxy):
#   - IA na mesma máquina do navegador:  http://localhost:11434
#   - IA no PC Gamer, testando pela LAN:  http://192.168.1.50:11434  (troque pelo IP real da 3060)
#   - produção (via Cloudflare Tunnel/proxy): https://sua-url-publica
VITE_OLLAMA_URL=http://localhost:11434

# Qual modelo usar. Na 3060 dá pra usar o 8B (melhor qualidade):
#   llama3.2:3b  (leve)   |   llama3.1:8b  (melhor, exige GPU)
VITE_OLLAMA_MODEL=llama3.2:3b
