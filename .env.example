# Configuração do Astrodny — copie este arquivo para `.env.local` e ajuste os valores.
# (o `.env.local` é lido pelo Vite e NÃO deve ir pro versionamento)

# Groq (free tier) — a IA do Estudar/Trabalhos em dev, e um dos elos do chat.
# Pega em: console.groq.com/keys.
VITE_GROQ_API_KEY=
VITE_GROQ_MODEL=openai/gpt-oss-120b

# Supabase (login com Google + perfil). Sem isso preenchido, o app continua
# funcionando 100% anônimo — só o botão "Entrar com Google" fica desativado.
# Pega em: painel do Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
